{
  "name": "tokyo-league",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "assets:download": "node ./scripts/download-site-images.mjs",
    "assets:organize": "node ./scripts/organize-site-images.mjs",
    "import:history": "node ./scripts/run-with-env.mjs node ./scripts/import-history-from-site.mjs",
    "import:results": "node ./scripts/run-with-env.mjs node ./scripts/import-match-results-from-images.mjs",
    "docs:spec": "node ./docs/build-spec-pdf.mjs",
    "docs:admin": "node ./docs/admin-manual/build-admin-manual.mjs",
    "docs:admin:screenshots": "node ./docs/admin-manual/capture-admin-screenshots.mjs",
    "docs:admin:qa": "node ./docs/admin-manual/render-manual-qa.mjs",
    "docs:delivery:check": "node ./scripts/check-delivery-artifacts.mjs",
    "delivery:evidence": "node ./scripts/collect-delivery-evidence.mjs",
    "public:routes": "node ./scripts/check-public-routes.mjs",
    "security:headers": "node ./scripts/check-security-headers.mjs",
    "security:prod-env": "node ./scripts/check-production-env.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:push": "node ./scripts/run-with-env.mjs prisma db push",
    "prisma:migrate": "node ./scripts/run-with-env.mjs prisma migrate dev --name init",
    "prisma:seed-admin": "node ./scripts/run-with-env.mjs node ./scripts/seed-admin.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.1",
    "@prisma/client": "^6.6.0",
    "@vercel/blob": "^2.3.3",
    "image-size": "^2.0.2",
    "next": "15.2.8",
    "next-auth": "5.0.0-beta.30",
    "prisma": "^6.6.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "22.13.14",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "typescript": "5.8.2"
  }
}
